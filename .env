# Backend API base URL (Vite dev server proxies /api to this)
VITE_API_URL=http://localhost:8080

# Optional: override backend URL for production builds
# VITE_API_URL=https://api.codesphere.example.com
# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codesphere
DB_USERNAME=rahul
DB_PASSWORD=DB_PASSWORD

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=86400000

# Run coding submissions in isolated Docker containers with real test cases.
JUDGE_USE_DOCKER=true

# Server
SERVER_PORT=8080

# Frontend
FRONTEND_URL=http://localhost:5173

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# MinIO File Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=codesphere-files

# Mail (for email notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_password

